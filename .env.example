TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@noon_hot_deals

# Your noon influencer coupon code — shown in every Telegram post as tap-to-copy.
# Defaults to "gado" if unset. Override here to use a different code.
NOON_COUPON_CODE=gado

# Site indexing. Both are public by design — they are published as files on the
# site itself, which is what proves ownership. Set them only when verifying your
# own property; unset falls back to the tokens baked into the code.
# GOOGLE_SITE_VERIFICATION=googleXXXXXXXXXXXXXXXX.html
# INDEXNOW_KEY=32-char-random-hex
